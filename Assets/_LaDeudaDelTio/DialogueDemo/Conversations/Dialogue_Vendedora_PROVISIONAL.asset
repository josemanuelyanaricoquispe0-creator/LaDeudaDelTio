--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17e51cf6a239429d9a977320bf388e20, type: 3}
  m_Name: Dialogue_Vendedora_PROVISIONAL
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "Chamán"
    text: "Buenas noches, caserita. ¿Ya está cerrando?"
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: -5240138286427330706, guid: 9147ca5b1400b364d8271cc957527ec1, type: 3}
  - speakerName: "Vendedora del mercado"
    text: "Sí, Tata. Ahora todos cerramos temprano. Nadie quiere quedarse solo en la calle."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: -5240138286427330706, guid: 9147ca5b1400b364d8271cc957527ec1, type: 3}
  - speakerName: "Chamán"
    text: "¿Por qué? ¿Qué está pasando?"
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: -5240138286427330706, guid: 9147ca5b1400b364d8271cc957527ec1, type: 3}
  - speakerName: "Vendedora del mercado"
    text: "Por el camino del cerro se oyen pasos... pero uno mira y no hay nadie."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: -5240138286427330706, guid: 9147ca5b1400b364d8271cc957527ec1, type: 3}
  - speakerName: "Chamán"
    text: "¿Usted también los escuchó?"
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: -5240138286427330706, guid: 9147ca5b1400b364d8271cc957527ec1, type: 3}
  - speakerName: "Vendedora del mercado"
    text: "Anoche, junto al puesto. Guardé mis cosas sin volver a mirar."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: -5240138286427330706, guid: 9147ca5b1400b364d8271cc957527ec1, type: 3}
  - speakerName: "Chamán"
    text: "Voy a averiguar qué sucede."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: -5240138286427330706, guid: 9147ca5b1400b364d8271cc957527ec1, type: 3}
  - speakerName: "Vendedora del mercado"
    text: "Vaya con cuidado, pues. A estas horas yo no subiría por ese camino."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: -5240138286427330706, guid: 9147ca5b1400b364d8271cc957527ec1, type: 3}
