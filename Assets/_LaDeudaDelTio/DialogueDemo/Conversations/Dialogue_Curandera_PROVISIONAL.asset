--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17e51cf6a239429d9a977320bf388e20, type: 3}
  m_Name: Dialogue_Curandera_PROVISIONAL
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "Chamán"
    text: "Me dijeron que usted prepara protecciones para quienes suben al cerro."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 4719066600942818384, guid: 64b2a604b215da34687fa9020d3fec7a, type: 3}
  - speakerName: "Curandera andina"
    text: "Conozco algunas plantas y las ofrendas que se acostumbran llevar, Tata."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 4719066600942818384, guid: 64b2a604b215da34687fa9020d3fec7a, type: 3}
  - speakerName: "Chamán"
    text: "¿Podrían ayudarme?"
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 4719066600942818384, guid: 64b2a604b215da34687fa9020d3fec7a, type: 3}
  - speakerName: "Curandera andina"
    text: "Podemos buscar los materiales y prepararlas. Pero hay que hacerlo con cuidado."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 4719066600942818384, guid: 64b2a604b215da34687fa9020d3fec7a, type: 3}
  - speakerName: "Chamán"
    text: "Si encuentro algo en el camino, tendré que defenderme."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 4719066600942818384, guid: 64b2a604b215da34687fa9020d3fec7a, type: 3}
  - speakerName: "Curandera andina"
    text: "No todo lo que anda por el cerro se enfrenta con un arma."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 4719066600942818384, guid: 64b2a604b215da34687fa9020d3fec7a, type: 3}
  - speakerName: "Chamán"
    text: "Entonces no bastará con ir armado."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 4719066600942818384, guid: 64b2a604b215da34687fa9020d3fec7a, type: 3}
  - speakerName: "Curandera andina"
    text: "Primero averigüe qué tiene delante. Después veremos cómo preparar la protección."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 4719066600942818384, guid: 64b2a604b215da34687fa9020d3fec7a, type: 3}
