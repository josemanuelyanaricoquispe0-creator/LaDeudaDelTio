MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 17e51cf6a239429d9a977320bf388e20, type: 3}
  m_Name: Dialogue_DonaRosa_PROVISIONAL
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: "Chamán"
    text: "Buenas noches, Doña Rosa. ¿Qué se cuenta de estos cerros?"
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 2055983830258549882, guid: 6e4a964da39053d43a6f15aa12b23093, type: 3}
  - speakerName: "Doña Rosa"
    text: "Tata, dicen que por estos cerros aparece una cabeza que vuela durante la noche."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 2055983830258549882, guid: 6e4a964da39053d43a6f15aa12b23093, type: 3}
  - speakerName: "Chamán"
    text: "¿Una cabeza?"
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 2055983830258549882, guid: 6e4a964da39053d43a6f15aa12b23093, type: 3}
  - speakerName: "Doña Rosa"
    text: "Sí. Algunos cuentan que persigue a las personas cuando están solas."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 2055983830258549882, guid: 6e4a964da39053d43a6f15aa12b23093, type: 3}
  - speakerName: "Chamán"
    text: "¿El Qati Qati? Creí que ya nadie hablaba de esas cosas."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 2055983830258549882, guid: 6e4a964da39053d43a6f15aa12b23093, type: 3}
  - speakerName: "Doña Rosa"
    text: "Y si alguna noche escucha la voz de un familiar, no se confíe."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 2055983830258549882, guid: 6e4a964da39053d43a6f15aa12b23093, type: 3}
  - speakerName: "Chamán"
    text: "¿Una voz conocida también puede ser peligrosa?"
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 2055983830258549882, guid: 6e4a964da39053d43a6f15aa12b23093, type: 3}
  - speakerName: "Doña Rosa"
    text: "No se confíe, Tata... de noche es mejor mirar bien antes de responder."
    leftPortrait: {fileID: 91569026638618976, guid: cee64c11a6e9cd049bc5bc3d1693409c, type: 3}
    rightPortrait: {fileID: 2055983830258549882, guid: 6e4a964da39053d43a6f15aa12b23093, type: 3}
