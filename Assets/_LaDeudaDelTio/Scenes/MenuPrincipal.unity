  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "CR\xC9DITOS\n\nSECRETOS DE LA PACHAMAMA\n\nCap\xEDtulo I: La Deuda del
    T\xEDo\n\nDESARROLLADO POR \u2014 EQUIPO CP\n\nJos\xE9 Manuel Yanarico Quispe\nL\xEDder
    del equipo y programador\nCoordinaci\xF3n del equipo, organizaci\xF3n del desarrollo,
    programaci\xF3n de escenas e integraci\xF3n de los sistemas del videojuego.\n\nC\xE9sar
    Antonio Aliaga Luizaga\nProgramador de mec\xE1nicas\nDesarrollo e implementaci\xF3n
    de mec\xE1nicas jugables, sistemas de combate, comportamiento de enemigos y funcionalidades
    del personaje.\n\nHugo David Garc\xEDa Salazar\nDise\xF1ador de escenarios y
    di\xE1logos\nCreaci\xF3n y ambientaci\xF3n de escenarios, desarrollo de di\xE1logos,
    interacciones con personajes y apoyo en la narrativa del videojuego.\n\nJhon
    Elmeth Quiroz Rocha\nDise\xF1o creativo e interfaz\nAporte de ideas y conceptos
    para el videojuego, dise\xF1o del men\xFA principal, selecci\xF3n de cap\xEDtulos,
    interfaz visual e implementaci\xF3n de efectos de sonido.\n\nDESARROLLO COLABORATIVO\n\nAnimaciones
    y personajes\nDesarrollados en conjunto por los cuatro integrantes del equipo.\n\nDise\xF1o
    y desarrollo general\nTrabajo colaborativo en la creaci\xF3n de escenarios, cinem\xE1ticas,
    narrativa y elementos inspirados en las leyendas y tradiciones bolivianas.\n\nMotor
    de desarrollo: Unity 6.5\nLenguaje de programaci\xF3n: C#\n\nInspirado en la
    riqueza cultural, las leyendas y las tradiciones de Bolivia.\n\nGAME JAM 2026\n\nEQUIPO
    Club Panitas"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
